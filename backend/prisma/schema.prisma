generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

model ProjectSnapshot {
id Int @id
projectName String
projectDescription String
creatorName String
cid String
fundingGoalWei String
amountRaisedWei String
totalContributors Int
creationTime BigInt
durationSeconds BigInt
category Int
updatedAt DateTime @updatedAt
}

model ContributionSnapshot {
id Int @id @default(autoincrement())
projectId Int
contributor String
amountWei String
updatedAt DateTime @updatedAt

@@unique([projectId, contributor])
}

model SyncState {
key String @id
value String
updatedAt DateTime @updatedAt
}